---
import '../styles/site.css';
interface Props { title?: string; description?: string; path?: string }
const { title, description = 'Token and cost totals for every AI coding agent you run, from the session files already on your disk. Local first, open source.', path = '/' } = Astro.props;
const full = title ? `${title} · Tokmeter` : 'Tokmeter — every AI coding agent, on one ledger';
const nav = [
  ['/install/', 'Install'],
  ['/cli/', 'CLI'],
  ['/menu-bar/', 'Menu bar'],
  ['/mcp/', 'MCP'],
  ['/numbers/', 'The numbers'],
  ['/faq/', 'FAQ'],
];
const canonical = new URL(path, 'https://tokmeter.srinivas.dev').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://tokmeter.srinivas.dev/images/theme-paper.jpg" />
    <meta name="theme-color" content="#07080d" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="brand" href="/"><img src="/icon.png" width="28" height="28" alt="" /><span>Tokmeter</span></a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="docs-link" href="/install/">Docs</a>
      <a class="gh" href="https://github.com/sriinnu/tokmeter">GitHub</a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-foot">
      <div class="foot-grid">
        <div class="foot-brand">
          <a class="brand" href="/"><img src="/icon.png" width="32" height="32" alt="" /><span>Tokmeter</span></a>
          <p>Token and cost totals for every AI coding agent you run, read from your own disk. No account, no telemetry.</p>
        </div>
        <nav aria-label="Use">
          <h2>Use</h2>
          <a href="/install/">Install</a>
          <a href="/cli/">CLI</a>
          <a href="/menu-bar/">Menu bar and themes</a>
          <a href="/mcp/">MCP tools</a>
          <a href="/daemon/">Daemon and HTTP API</a>
        </nav>
        <nav aria-label="Trust">
          <h2>Trust</h2>
          <a href="/numbers/">How the numbers work</a>
          <a href="/backup/">Backup and restore</a>
          <a href="/troubleshooting/">Troubleshooting</a>
          <a href="/architecture/">Architecture</a>
        </nav>
        <nav aria-label="Project">
          <h2>Project</h2>
          <a href="https://github.com/sriinnu/tokmeter">GitHub</a>
          <a href="https://github.com/sriinnu/tokmeter/releases">Releases</a>
          <a href="https://www.npmjs.com/package/@sriinnu/tokmeter">npm</a>
          <a href="https://github.com/sriinnu/tokmeter/blob/main/SECURITY.md">Security</a>
        </nav>
      </div>
      <p class="foot-base">
        <span>Applications are <a href="https://github.com/sriinnu/tokmeter/blob/main/LICENSE">AGPL-3.0</a>; the core library is MPL-2.0. Built by <a href="https://srinivas.dev">Srinivas Pendela</a>.</span>
        <span>CLI: Node.js 18+ (22.13+ for SQLite-based tools) · Menu bar: macOS 14+</span>
      </p>
    </footer>
  </body>
</html>
