---
import Base from '../layouts/Base.astro';
import TokenStream from '../components/TokenStream.astro';
// The released version, straight from the package the CLI ships in.
import pkg from '../../../packages/tokmeter/package.json';

const agents = [
  'Claude Code', 'Codex', 'Codex Desktop', 'Gemini CLI', 'Cursor', 'OpenCode', 'Amp', 'Droid',
  'OpenClaw', 'Pi', 'Kimi', 'Qwen Code', 'Roo Code', 'Kilo Code', 'Kilo CLI', 'Mux',
  'VS Code Copilot', 'Copilot CLI', 'Antigravity', 'Zed', 'Muse', 'Cline', 'Augment', 'Synthetic',
  'Ribhu', 'Chitragupta',
];

const themes = [
  ['paper', 'Paper', 'A broadsheet, set in serif', '#e8dfc8'],
  ['meter', 'Meter', 'A utility meter under glass', '#c8322a'],
  ['pump', 'Pump', 'A fuel-pump computer', '#f5b041'],
  ['rams', 'Rams', 'A calculator, colour only where it means something', '#f2c230'],
  ['deck', 'Deck', 'An 80s hi-fi display', '#4fe3e1'],
  ['passbook', 'Passbook', 'A savings passbook', '#3d7a5c'],
  ['terminal', 'Terminal', 'Green phosphor', '#3ef07a'],
  ['nebula', 'Prism', 'Light through glass', '#8b5cf6'],
  ['aurora', 'Lagoon', 'Deep water', '#06b6d4'],
  ['nocturne', 'Carbon', 'Quiet, dark, dense', '#9aa3b2'],
  ['glass', 'Glass', 'Native desktop frost', '#cfd8e6'],
];

const surfaces = [
  ['/cli/', 'Terminal', 'CLI and TUI', 'Today, this week, any project or model. <code>tokmeter --today</code>, a weekly digest, and a full-screen terminal UI.'],
  ['/menu-bar/', 'macOS', 'Menu bar app', 'Today’s tokens in the menu bar. Open it for cost, models, projects and a $/M rates panel, in eleven themes.'],
  ['/mcp/', 'Agents', 'MCP server', '24 tools, so an agent can ask what it has spent, compare models or forecast the month. 22 only read; the two that delete need a typed confirmation.'],
  ['/daemon/', 'Local API', 'Daemon', 'One process scans once and serves every surface over <code>127.0.0.1</code>, token-protected.'],
  ['/install/', 'Editors', 'Statusline', 'This session’s tokens and cost under your prompt in Claude Code, OpenCode and Ribhu, plus today’s total across every agent. It never waits on the daemon: a late number shows dimmed with its age.'],
  ['/install/', 'Browser', 'Web dashboard', 'Larger charts on demand, started and stopped by the menu bar app.'],
];
---
<Base path="/">
  <TokenStream lanes={agents.length}>
    <div class="hero">
      <p class="eyebrow">Open source · local first <span class="ver">v{pkg.version}</span></p>
      <h1>Every AI coding agent,<br /><em>on one ledger.</em></h1>
      <p class="lede">Tokmeter reads the session files your agents already write and turns them into token and cost totals by project, model and day. No provider API keys, no account, no telemetry.</p>
      <div class="cta">
        <a class="btn primary" href="https://github.com/sriinnu/tokmeter/releases/latest">Download for macOS</a>
        <a class="btn ghost" href="/install/">Read the docs</a>
      </div>
      <div class="install" data-tabs>
        <div role="tablist" aria-label="Install">
          <button role="tab" id="t-cli" aria-controls="p-cli" aria-selected="true">CLI</button>
          <button role="tab" id="t-app" aria-controls="p-app" aria-selected="false" tabindex="-1">Menu bar</button>
          <button role="tab" id="t-mcp" aria-controls="p-mcp" aria-selected="false" tabindex="-1">MCP</button>
        </div>
        <pre role="tabpanel" id="p-cli" aria-labelledby="t-cli"><code><span class="prompt">$ </span>npx -y @sriinnu/tokmeter --today</code></pre>
        <pre role="tabpanel" id="p-app" aria-labelledby="t-app" hidden><code><span class="prompt">$ </span>brew install --cask sriinnu/homebrew-tap/tokmeterbar</code></pre>
        <pre role="tabpanel" id="p-mcp" aria-labelledby="t-mcp" hidden><code><span class="prompt">$ </span>claude mcp add tokmeter --scope user -- npx -y @sriinnu/tokmeter-mcp serve</code></pre>
      </div>
    </div>
  </TokenStream>

  <div class="agents" aria-label="Supported agents">
    <p>Built-in parsers for {agents.length} agents, plus any you register</p>
    <div class="marquee" aria-hidden="true">
      {[...agents, ...agents].map((a) => <span>{a}</span>)}
    </div>
    <ul class="sr-only">{agents.map((a) => <li>{a}</li>)}</ul>
  </div>

  <div class="wrap">
    <section class="block reveal">
      <p class="kicker">How it works</p>
      <h2>From session file to ledger.</h2>
      <p class="sub">Every agent already keeps a log of what it sent and received. Tokmeter reads those logs where they sit and keeps the totals.</p>
      <ol class="pipeline">
        <li>
          <h3>Read</h3>
          <p>Each agent's own session files, JSONL or SQLite, straight from disk. Counted once per API response, even when a provider writes a turn across several lines.</p>
          <pre class="art" aria-label="A session log line"><span class="k">"message"</span>: &#123;"id": "msg_01…",
  <span class="k">"model"</span>: "claude-sonnet-4-6",
  <span class="k">"usage"</span>: &#123;
    <span class="v">"input_tokens"</span>: 1840,
    <span class="v">"output_tokens"</span>: 312,
    <span class="v">"cache_read_input_tokens"</span>: 42210
  &#125;&#125;</pre>
        </li>
        <li>
          <h3>Price</h3>
          <p>Tokens are priced against a live model catalog, with your <code>pricing-overrides.json</code> on top. Tool-reported costs are kept as reported.</p>
          <pre class="art" aria-label="A rate row"><span class="dim">model        input  output  per M</span>
sonnet-4-6   <span class="v">$3.00</span>  <span class="v">$15.00</span>
<span class="dim">source</span>       catalog · exact match</pre>
        </li>
        <li>
          <h3>Seal</h3>
          <p>At midnight the day is sealed into an append-only ledger. A sealed day keeps the prices of its day, even after the raw logs age out.</p>
          <pre class="art" aria-label="Ledger rows"><span class="dim">10-10</span>  4.21M  <span class="m">$12.40</span>  <span class="seal">sealed</span>
<span class="dim">10-11</span>  2.87M   <span class="m">$8.15</span>  <span class="seal">sealed</span>
<span class="dim">10-12</span>  1.02M   <span class="m">$2.45</span>  <span class="live">live</span></pre>
        </li>
      </ol>
    </section>

    <section class="block reveal">
      <p class="kicker">Today, at a glance</p>
      <h2>The same day, in your terminal and your menu bar.</h2>
      <p class="sub">Sample data. The popover is drawn by the app's own views; the table follows the CLI's project table, column for column.</p>
      <div class="showcase">
        <figure class="term">
          <div class="term-bar"><i></i><i></i><i></i><span>zsh</span></div>
<pre><span class="prompt">$</span> tokmeter --today
┌─────────────┬──────────┬───────┬────────┬───────────┬─────────────┐
│ <span class="h">Project</span>     │ <span class="h">Tokens</span>   │ <span class="h">Cost</span>  │ <span class="h">Models</span> │ <span class="h">Providers</span> │ <span class="h">Active Days</span> │
├─────────────┼──────────┼───────┼────────┼───────────┼─────────────┤
│ sample-web  │ 375.0K   │ <span class="m">$1.40</span> │ 2      │ 2         │ 1           │
├─────────────┼──────────┼───────┼────────┼───────────┼─────────────┤
│ sample-api  │ 625.0K   │ <span class="m">$1.05</span> │ 1      │ 1         │ 1           │
└─────────────┴──────────┴───────┴────────┴───────────┴─────────────┘</pre>
          <figcaption>Sample data</figcaption>
        </figure>
        <figure class="pop">
          <img src="/images/paper-expanded.jpg" alt="The menu bar popover in the Paper theme with usage details open, showing sample data" loading="lazy" width="400" height="788" />
          <figcaption>Paper theme · sample data</figcaption>
        </figure>
      </div>
    </section>

    <section class="block reveal">
      <p class="kicker">Surfaces</p>
      <h2>One scan, everywhere you look.</h2>
      <p class="sub">The CLI, the menu bar, your agents and your statusline all read the same numbers from the same local daemon.</p>
      <div class="surfaces">
        {surfaces.map(([href, tag, title, text]) => (
          <a href={href}><span class="tag">{tag}</span><h3>{title}</h3><p set:html={text} /></a>
        ))}
      </div>
    </section>

    <section class="block reveal">
      <div class="gallery-head">
        <div>
          <p class="kicker">The menu bar</p>
          <h2>Eleven ways to read the same day.</h2>
          <p class="sub">Five are instruments: a utility meter, a fuel pump, a calculator, a hi-fi deck, a passbook. Every element on them is a real reading.</p>
        </div>
        <a class="btn ghost" href="/menu-bar/">About the themes</a>
      </div>
      <div class="deck" tabindex="0" aria-label="Themes, scroll sideways">
        {themes.map(([id, name, line, color]) => (
          <figure style={`--c:${color}`}>
            <img src={`/images/theme-${id}.jpg`} alt={`The menu bar popover in the ${name} theme, showing sample data`} loading="lazy" width="400" height="620" />
            <figcaption><b>{name}</b><span>{line}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="block reveal">
      <p class="kicker">Numbers you can check</p>
      <h2>Wrong numbers are worse than no numbers.</h2>
      <p class="sub">Tokmeter shows its work, and says so when a figure is an estimate.</p>
      <div class="trust">
        <div>
          <h3>Estimates are labelled</h3>
          <p>API-rate estimates and costs a tool reported itself are kept apart and named as such. Neither is your subscription bill.</p>
        </div>
        <div>
          <h3>History doesn't move</h3>
          <p>Only today reprices. A completed day keeps the cost it was sealed with, and a rebuild may grow a sealed day, never shrink it.</p>
        </div>
        <div>
          <h3>Your data stays put</h3>
          <p>Usage is read and stored on your machine. The only network calls are an optional public price-catalog fetch (<code>--light</code> skips it) and the app's update check.</p>
        </div>
        <div>
          <h3>Every rate has a source</h3>
          <p>The $/M panel shows each model's input, output and cache prices, and whether they came from your override, an exact or fuzzy catalog match, or nowhere.</p>
        </div>
      </div>
      <p><a class="btn ghost" href="/numbers/">How the numbers work</a></p>
    </section>

    <section class="block closer reveal">
      <h2>Know what today cost.</h2>
      <p class="sub">Free and open source. Install the CLI in one line, or the menu bar app from GitHub or Homebrew.</p>
      <div class="cta">
        <a class="btn primary" href="https://github.com/sriinnu/tokmeter/releases/latest">Download for macOS</a>
        <a class="btn ghost" href="https://github.com/sriinnu/tokmeter">Source on GitHub</a>
      </div>
    </section>
  </div>
</Base>

<script>
  // Install tabs: arrow keys move between tabs, as the ARIA pattern expects.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
    box.querySelectorAll('pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'copy'; btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        const text = pre.querySelector('code')!.textContent!.replace(/^\$ /, '');
        try { await navigator.clipboard.writeText(text); btn.textContent = 'Copied'; }
        catch { btn.textContent = 'Press ⌘C'; }
        setTimeout(() => (btn.textContent = 'Copy'), 1400);
      });
      pre.appendChild(btn);
    });
  });

  // Fade sections in as they scroll into view.
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
